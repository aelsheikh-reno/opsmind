// Kernel schema — target shapes from docs/architecture/data-model.md.
//
// Scope: the tables data-ownership.md assigns to the Kernel. Module-owned
// tables (SalarySchedule, SalaryTerm, OpenItem, Settlement, TaxFiling,
// BillablePosition, LeaseSchedule, LoanSchedule, Scenario, ScenarioEvent and
// the Projects / Expenses tables) arrive with their modules.
//
// Money is never a float: every amount is Decimal, scaled to three decimal
// places because KWD and BHD are three-decimal currencies (CLAUDE.md, money
// and dates). Note that on Document, amount and currency are independently
// optional — carried from the legacy shape, where a document may be filed
// before its value is extracted. An amount without a currency is therefore
// representable here and is a validation rule for ingestion, not a schema
// constraint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shared vocabulary
// ---------------------------------------------------------------------------

/// Money and the documents that evidence it always state which way it flows;
/// it is never inferred from context (ADR-027, CLAUDE.md rule 6). ADR-025
/// describes the legacy database's nullable-then-backfill path and is scoped
/// out of this build.
enum Direction {
  inbound
  outbound
}

/// Stops legal entities being auto-created from fuzzy name matches.
enum EntityRole {
  self
  client
  vendor
}

/// The obligations a jurisdiction can impose. data-model.md:157 lists
/// `vat | corporate_tax | social_insurance | ...`; the three named are the
/// floor, and the list is extended by migration as regimes are added.
enum ObligationType {
  vat
  corporate_tax
  social_insurance
}

/// How often a registration files. data-model.md says "Monthly or quarterly",
/// which is descriptive rather than exhaustive: UAE corporate tax is filed
/// annually, so a registration for it is unrepresentable without `annual`.
/// `semiannual` is included with it — Ahmed's decision, 2026-08-14 — so the
/// realistic cadences are covered in one migration rather than discovered one
/// gap at a time.
enum EnrolmentFrequency {
  monthly
  quarterly
  semiannual
  annual
}

// ---------------------------------------------------------------------------
// Jurisdiction, calendar and the law
// ---------------------------------------------------------------------------

model Jurisdiction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// ISO 3166-1 alpha-2, e.g. "AE", "EG", "SA", "KW", "BH".
  code      String   @unique
  name      String

  calendar         BusinessCalendar?
  regimes          Regime[]
  personEnrolments PersonEnrolment[]
}

/// The working week and the non-working days a deadline must step over.
/// Deadline arithmetic reads this, never plain UTC days (CLAUDE.md rule 9).
model BusinessCalendar {
  id             String       @id @default(cuid())
  jurisdictionId String       @unique
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  /// Non-working weekdays, encoded as day numbers where 0 = Sunday and
  /// 6 = Saturday. The Gulf working week is Sunday-Thursday, so its mask is
  /// [5, 6] — Friday and Saturday. No default: a calendar states its own week.
  weekendMask Int[]

  /// The IANA zone whose CIVIL date is "today" in this jurisdiction —
  /// "Asia/Dubai", "Africa/Cairo". It lives here rather than on Jurisdiction
  /// because Jurisdiction is identity and this is a civil-time rule, beside the
  /// weekend mask and the holidays (Ahmed's decision, 2026-08-14).
  ///
  /// Required, and with no default. The deadline sweep runs at 02:00, which in
  /// the Gulf is 22:00 the previous UTC day: scored against UTC it would warn a
  /// day late, and a default zone is that same defect written down once and
  /// then trusted.
  timeZone String

  holidays BusinessHoliday[]
}

model BusinessHoliday {
  id         String           @id @default(cuid())
  calendarId String
  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  name       String

  @@unique([calendarId, date])
}

/// The law itself: jurisdiction x obligation type, holding the rates, brackets
/// and deadline days that were hardcoded in the previous build. Adding excise
/// or a new country is a row here, never a migration (ADR-017).
model Regime {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)

  /// A closed set, not a free string. data-model.md's trailing "..." means the
  /// set grows, not that any value is acceptable: an unvalidated obligation
  /// type lets an extraction write `VAT`, `vat_uae` and `Vat` as three distinct
  /// regimes that no filing query would ever reunite. Adding an obligation is
  /// therefore a migration. Ahmed's decision, 2026-08-14.
  obligationType ObligationType
  name           String

  rate         Decimal @db.Decimal(9, 6)
  /// Plain CALENDAR days after period end by which the filing is due. Not
  /// business days, and not rolled forward off a weekend: legacy adds them
  /// directly (`dueDate.setDate(dueDate.getDate() + filingDeadlineDays)` in
  /// lib/tax.ts and lib/vat.ts) and that is the behaviour to match. UAE VAT is
  /// 28 days; read as business days it would land about twelve days late,
  /// which is a filing penalty.
  ///
  /// This is deliberately in tension with CLAUDE.md rule 9: a due date CAN
  /// fall on a Friday or a public holiday. Ahmed's decision, 2026-08-14 — the
  /// statutory deadline is the statutory deadline, and moving it because the
  /// office is shut would misreport when the filing is actually late.
  /// module-deadlines should surface that a deadline falls on a non-working
  /// day, not silently shift it.
  deadlineDays Int

  /// Registration and exemption thresholds.
  thresholds Json?
  /// Banded rates, e.g. the Egyptian income tax bands.
  brackets   Json?

  enrolments JurisdictionEnrolment[]

  @@index([jurisdictionId, obligationType])
}

// ---------------------------------------------------------------------------
// Parties
// ---------------------------------------------------------------------------

model LegalEntity {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  name      String
  country   String
  currency  String?
  active    Boolean    @default(true)
  /// self | client | vendor — stated, never inferred from a name match.
  role      EntityRole

  documents  Document[]
  enrolments JurisdictionEnrolment[]
}

/// An entity's standing under a regime: the registration number, how often it
/// files and what the period aligns to. Applies to counterparties too — a UAE
/// VAT invoice carries the customer's TRN. Replaces VatConfig + TaxConfig.
model JurisdictionEnrolment {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  regimeId      String
  regime        Regime      @relation(fields: [regimeId], references: [id], onDelete: Restrict)

  /// TRN or the equivalent registration number.
  identifier String
  frequency  EnrolmentFrequency
  /// What the filing period aligns to — periods are counted from this date.
  anchor     DateTime           @db.Date

  /// Registration is not permanent. A null activeTo means still registered.
  activeFrom DateTime  @db.Date
  activeTo   DateTime? @db.Date

  /// The registration certificate, as evidence (CLAUDE.md rule 7). Optional:
  /// the registration is the record, the certificate is proof of it, and the
  /// proof can arrive after the number is known.
  sourceDocumentId String?
  sourceDocument   Document? @relation("EnrolmentCertificate", fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([legalEntityId, regimeId])
  @@index([regimeId])
}

// ---------------------------------------------------------------------------
// Documents and the registry
// ---------------------------------------------------------------------------

/// Files and their extracted metadata. Evidence, never the record itself
/// (CLAUDE.md rule 7). Payment state is not here: it is derived from
/// Settlement rows owned by Finance (ADR-015).
model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  filename String
  mimeType String
  source   String  @default("upload")
  status   String  @default("processing")
  filePath String?
  fileHash String?

  /// Which way the value flows. Not nullable: a supplier bill counted as
  /// income is the defect this closes (ADR-027, CLAUDE.md rule 6). An
  /// arriving document whose direction cannot be determined becomes a work
  /// item rather than a guessed row (CLAUDE.md rule 8).
  direction Direction

  /// Matches DocumentType.type in the registry.
  docType    String?
  confidence Float?
  parties    String?
  summary    String?
  notes      String?

  issueDate       DateTime?
  expiryDate      DateTime?
  renewalDeadline DateTime?

  amount          Decimal? @db.Decimal(18, 3)
  vatAmount       Decimal? @db.Decimal(18, 3)
  currency        String?
  paymentTerms    String?
  poStatus        String?  @default("open")
  referenceNumber String?
  issuingCountry  String?

  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  enrolmentCertificate JurisdictionEnrolment[] @relation("EnrolmentCertificate")
  employmentContract   Person?                 @relation("EmploymentContract")

  @@index([docType])
  @@index([direction])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// People and accounts
// ---------------------------------------------------------------------------

/// Staff identity: HR record, payroll subject, claimant and project resource in
/// one row. Deliberately NOT split per role — components-kernel.md notes it is
/// among the most referenced tables and separating the roles would migrate half
/// the schema to solve a problem that is not constraining delivery.
///
/// Compensation is not here. data-model.md moves the salary, its currency and
/// its components onto SalaryTerm — effective-dated, append-only rows owned by
/// Payroll (ADR-022) — so a raise never rewrites a period that has already been
/// paid. Legacy carried salary, salaryCurrency and salaryComponents as flat
/// columns edited in place, which is the history loss ADR-022 exists to stop;
/// those three do not come across. The hourly rates below do, because no
/// documented table replaces them (see the note on them).
model Person {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name        String
  email       String?
  jobTitle    String?
  department  String?
  nationality String?

  /// The org chart, required to resolve who approves what (data-model.md:119).
  /// Nullable because the top of the chart reports to nobody; that a chain must
  /// not loop is an application rule, not something a column can state.
  managerId String?
  manager   Person?  @relation("PersonManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Person[] @relation("PersonManager")

  contractStart DateTime? @db.Date
  contractEnd   DateTime? @db.Date
  exitDate      DateTime? @db.Date
  exitReason    String?

  /// "fulltime" | "parttime", carried from the legacy shape.
  employmentType            String  @default("fulltime")
  weeklyHours               Decimal @default(40) @db.Decimal(6, 2)
  payslipInContractCurrency Boolean @default(false)

  /// No costPerHour, billingRate or rateCurrency here. They were carried from
  /// the legacy shape and removed on review: a project's margin for a past
  /// month must not move when someone's rate changes today, which is the same
  /// argument ADR-022 makes for salary. They arrive effective-dated with
  /// kernel-rate-terms, which must merge before module-projects and
  /// module-payroll read them. Nothing reads them yet, so shipping a shape
  /// known to be wrong would only have to be migrated away from.

  /// The employment contract, as evidence — the person is the record, the PDF
  /// is proof of it (CLAUDE.md rule 7). Restrict, not the legacy Cascade:
  /// deleting the evidence must never delete the employee.
  documentId String?   @unique
  document   Document? @relation("EmploymentContract", fields: [documentId], references: [id], onDelete: Restrict)

  enrolments PersonEnrolment[]
  user       User?

  @@index([managerId])
}

/// A person's own registration in a jurisdiction: the social insurance number
/// or tax identifier, and the dates it is valid between (components-kernel.md,
/// "person-level enrolments (SI and tax identifiers per jurisdiction)"). Held
/// separately from Person because one person can be registered in several
/// jurisdictions at once, and a registration ends without the person leaving.
model PersonEnrolment {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)

  /// Which obligation the identifier is for. The same closed-set argument as
  /// Regime.obligationType: a free string lets an extraction write three
  /// spellings of one obligation that no query reunites.
  obligationType ObligationType
  /// The registration number itself — social insurance number, tax number.
  identifier     String

  /// Validity dates. A null activeTo means still registered.
  activeFrom DateTime  @db.Date
  activeTo   DateTime? @db.Date

  @@index([personId, jurisdictionId, obligationType])
  @@index([jurisdictionId])
}

/// An account. Authentication only: the provider, the provider's subject and
/// the credential hash, so an IdP change re-points that pair without touching
/// anything else (security-authentication.md). Roles, grants and scopes live in
/// the Authorization service and never here — ADR-007. The legacy User carried
/// `role` and a `permissions` JSON blob; that is what this build replaces.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email String @unique
  name  String

  /// Which identity provider authenticates this user; exactly one, never two
  /// (ADR-008). A string rather than an enum because security-authentication.md
  /// makes adding Okta "a provider entry, not a rewrite" — an enum would make
  /// every new customer's IdP a schema migration.
  provider     String  @default("credentials")
  /// The provider's subject claim. Null for the credentials provider, which
  /// identifies the user by email and holds a hash instead.
  providerSub  String?
  /// bcrypt. Null for a user who authenticates through an external provider —
  /// there is no local credential to store, and an empty string would look like
  /// one.
  passwordHash String?

  /// The staff record this account acts as, where there is one. Null for the
  /// break-glass administrator, who is an account without an employee behind
  /// it. Restrict: an account must be dealt with explicitly, never orphaned by
  /// a person's removal.
  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Restrict)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  lastSeenAt  DateTime?

  @@unique([provider, providerSub])
}

// ---------------------------------------------------------------------------
// The document type registry
// ---------------------------------------------------------------------------

/// What the retention clock counts from. It differs per statute, which is why
/// it is stored rather than assumed (data-retention.md).
enum RetentionBasis {
  end_of_financial_year
  end_of_tax_period
  document_date
}

/// How a data-subject erasure request is honoured for a document type.
/// `redact_personal` clears the personal fields and leaves the financial record
/// standing, which is how statutory retention and the right to erasure are
/// reconciled; `full_delete` is for types no statute requires keeping. Exactly
/// these two values (ADR-023).
enum ErasureMode {
  redact_personal
  full_delete
}

/// The registry: one row per document type, holding the extraction schema, the
/// retention policy and how erasure is honoured — all as data, editable in
/// Settings, because a statute changing must be a configuration change and not
/// a release (ADR-023). The ingestion rule catalogue that components-kernel.md
/// lists alongside these is IngestionRule, a separate kernel table that arrives
/// with the ingestion work.
model DocumentType {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Matches Document.docType.
  type     String @unique
  label    String
  category String

  /// The extraction schema handed to the parser on every call.
  fields Json

  /// Seven years by default: UAE corporate tax requires seven from the end of
  /// the financial year and VAT five from the end of the tax period, and since
  /// one invoice serves both regimes the longer period governs. Per-type
  /// because the statutes differ and change — data-retention.md says to confirm
  /// the actual numbers with the accountant; the schema only guarantees they
  /// are data.
  retentionYears Int            @default(7)
  retentionBasis RetentionBasis
  /// Blocks the purge job regardless of age, for disputes and investigations.
  legalHold      Boolean        @default(false)
  erasureMode    ErasureMode

  /// Who last changed this type and when — components-kernel.md requires the
  /// registry be "versioned with actor and timestamp". Actor and timestamp are
  /// on the row; prior versions are not retained here.
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

// ---------------------------------------------------------------------------
// FX
// ---------------------------------------------------------------------------

/// One observed rate on one date. Its own table, replacing the JSON blob the
/// legacy build kept in Setting under `fx_rates_cache`, so a rate can be looked
/// up as of a date instead of being whatever the cache last held.
///
/// A settlement or a payroll month copies the rate it used onto its own row, so
/// a processed period keeps its rate forever and is never recomputed from here.
model FxRate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// ISO-4217. rate is the number of `quote` units one `base` unit buys.
  base  String
  quote String

  /// Decimal, never Float: a rate multiplies money, so binary rounding here
  /// lands directly in an amount. Ten fractional digits carry both a
  /// thousands-scale rate and a small one at full published precision.
  rate Decimal @db.Decimal(20, 10)

  /// The date the rate is for. Rates are looked up as of a date, not "now".
  asOf DateTime @db.Date

  /// One rate per pair per day. A snapshot has to reproduce: a payslip
  /// converted last March must convert the same way when it is reopened, and
  /// two rows for one pair on one date make "the rate as of that date"
  /// ambiguous exactly where data-model.md says it is determinate. Ahmed's
  /// decision, 2026-08-14. Deliberately no `source` column — if a second rate
  /// provider ever arrives that is a migration, not a redesign, and adding the
  /// column speculatively would weaken this key today for a case that may
  /// never come.
  @@unique([base, quote, asOf])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only activity log, read back by the in-product timelines. Nothing in
/// this build ever deletes or amends an entry: it stays in the database because
/// of that read-back requirement, and an Object Lock archive is a later option.
///
/// Erasure redacts rather than deletes (ADR-023). A redaction clears the
/// personal fields on the entry and records that it happened, so the row and
/// its place in the timeline survive and the log stays immutable in shape.
/// That the database also refuse DELETE is a grant-level concern for
/// operations, not something this schema can state.
model AuditEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// What happened, and to what.
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  details     Json?

  /// The actor, copied rather than joined: an entry must still read correctly
  /// after the account is deactivated, and no foreign key may put the log at
  /// the mercy of another row's deletion.
  actorUserId String?
  actorName   String?

  /// The retention policy that WAS APPLIED, snapshotted at the moment a purge
  /// or an erasure ran. Null on every other kind of entry.
  ///
  /// This is how "what policy governed this action" is answered without
  /// versioning DocumentType. The registry keeps only its latest actor and
  /// timestamp; a purge destroys records, so the question is asked about a
  /// destruction that already happened, and a config table's current row
  /// cannot answer it. Copied rather than joined, for the same reason the actor
  /// is: an entry must still read correctly after the type is edited or
  /// deleted. Ahmed's decision, 2026-08-14 — see data-retention.md.
  appliedRetentionYears Int?
  appliedRetentionBasis RetentionBasis?
  appliedErasureMode    ErasureMode?

  /// Set when an erasure request has redacted entityLabel, details and
  /// actorName on this entry. Null means the entry is intact — the redaction is
  /// a recorded change, never a missing row.
  redactedAt      DateTime?
  redactedBy      String?
  redactionReason String?

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Deadline monitor
// ---------------------------------------------------------------------------

/// How serious a breach is. Detection decides severity; the Alert Manager
/// consumes it and never judges it (ADR-020). Only the two values the deadline
/// monitor's spec attests are here — its reportRun example carries `major` and
/// `minor` and nothing else. Adding a level is a migration, deliberately: an
/// unattested `critical` invented now would be a compliance value nobody
/// specified. Ahmed's constraint on derived fields, 2026-08-14.
enum AlertSeverity {
  minor
  major
}

/// A date the monitor watches. Created by registerDeadline(entityRef, type,
/// dueDate) and removed by deregisterDeadline; alerts resolve by absence from a
/// completed report, so a deregistered row simply stops being reported.
model DeadlineRegistration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// entityRef, as the two parts the fingerprint's entity segment is built
  /// from: `…:document:123:expiry` (data-model.md spells a reference this way
  /// on OpenItem, Settlement and search_index too). No foreign key — the row
  /// may point at a Document, a TaxFiling or a BillablePosition, all owned by
  /// other modules, and a cross-owner FK is exactly what stops a module being
  /// extracted later (ADR-021).
  entityType String
  entityId   String

  /// The `type` argument, and the key the threshold table is read by. It is
  /// also the fingerprint's policy segment — `expiry`, `due` — so identity
  /// survives a threshold being retuned.
  deadlineType String

  /// The `dueDate` argument. A date, not a timestamp: distance is counted in
  /// whole days. For a filing this is periodEnd + Regime.deadlineDays in plain
  /// calendar days and may land on a Friday; the monitor surfaces that rather
  /// than shifting it (see Regime.deadlineDays above).
  dueDate DateTime @db.Date

  /// Which BusinessCalendar measures the distance. Distance is business days
  /// against the jurisdiction's calendar, so a registration that cannot name
  /// its jurisdiction cannot be scored at all; a missing calendar is an error,
  /// never a Saturday-Sunday fallback. Held as an id with no relation: the
  /// Kernel owns Jurisdiction, and this module reads it through the kernel's
  /// interface rather than joining into its table (CLAUDE.md rule 1).
  jurisdictionId String

  /// One registration per fingerprint. Two rows for the same entity and type
  /// would compute one identity and report it twice, and a fingerprint is
  /// meant to be a deterministic identity for a stable fact. This is also what
  /// makes re-registering the same deadline idempotent.
  @@unique([entityType, entityId, deadlineType])
  @@index([dueDate])
}

/// Thresholds and severities, per deadline type — data in Settings, tunable
/// without a deployment, exactly as a SOC tunes detection rules (ADR-020).
/// Several rows per type give the escalating windows the compliance calendar
/// promises: 30 business days out is minor, 7 is major.
model ThresholdTable {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Matches DeadlineRegistration.deadlineType.
  deadlineType String

  /// The window, in BUSINESS days remaining, at or inside which this row's
  /// severity applies. Business days because "seven days" that lands on a
  /// weekend is not seven working days.
  businessDaysBefore Int

  severity AlertSeverity

  /// One severity per window per type. Two rows for the same window would make
  /// the reported severity depend on row order, and severity is monotonic while
  /// an alert is open — a value that flips is a resolve-then-reopen.
  @@unique([deadlineType, businessDaysBefore])
}
