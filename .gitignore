node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
.env
.env.*
!.env.example
# Database dumps and archives: never committed. They are large, they are
# regenerated, and they carry real salary and identity data.
*.sql
*.sql.gz
*.dump
# Prisma migrations are the exception, and they are not optional. `prisma
# migrate deploy` applies committed migration files and nothing else — it runs
# in gates.yml and again on every staging deploy — so a migration.sql swallowed
# by the *.sql rule above means the schema silently never reaches the database.
# gates.yml calls that "the one failure direction that hides". A migration is
# source, not a dump; it belongs in the diff a reviewer reads.
!prisma/migrations/**/*.sql
.task-current.yaml
# the legacy SOURCE is committed — it is the differential oracle and CI needs it.
# its dependencies and any data are not.
reference/legacy/node_modules/
reference/legacy/.next/
reference/legacy/.env*
reference/legacy/uploads/
